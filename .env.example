# Copiar a .env (que NO se sube al repositorio) y rellenar.
# En Koyeb estas mismas variables se cargan en el panel del servicio.

DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Neon: usar la rama "dev" en local y "main" en produccion. Conservar ?sslmode=require
DATABASE_URL=postgresql://usuario:clave@host/edumia?sslmode=require

TIME_ZONE=America/Caracas
LANGUAGE_CODE=es-ve
